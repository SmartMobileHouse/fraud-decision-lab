# Fraud Decision Lab — credentials for LIVE provider runs only.
# Offline runs, tests and the demo need none of these.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit it and never paste keys into chats or issues.
# Fill in only the providers you want to run; the others are skipped.

# TypeSafe Jev (System One API)
TYPESAFE_API_KEY=

# OpenAI Decisions + the structured-output LLM.
# Tip: use a project-scoped service-account key with a hard monthly budget.
OPENAI_API_KEY=

# Cloudflare Workers AI (Clef, Clef-flash). Token permissions: Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
